<Window x:Class="Kanban.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoardBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

  <StackPanel Margin="20">
    <TextBlock x:Name="PromptText" Margin="0,0,0,8" />
    <TextBox x:Name="InputBox" Padding="8,6" FontSize="14" MaxLength="200" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="OK" IsDefault="True" MinWidth="84" Padding="0,6" Margin="0,0,8,0" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" MinWidth="84" Padding="0,6" />
    </StackPanel>
  </StackPanel>

</Window>
