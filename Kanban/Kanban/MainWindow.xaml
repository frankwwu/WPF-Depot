<Window x:Class="Kanban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Kanban.Converters"
        xmlns:vm="clr-namespace:Kanban.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BoardViewModel}"
        Title="Kanban"
        Icon="kanban.ico"
        Width="1040" Height="660" MinWidth="760" MinHeight="420"
        Background="{DynamicResource BoardBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True">

  <Window.Resources>

    <conv:StatusBrushConverter x:Key="StatusBrush" />
    <conv:UserColorConverter x:Key="UserColor" />

    <!-- The "..." button on each card. It opens the card's context menu (see CardMenuButton_Click). -->
    <Style x:Key="CardMenuButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1"
                    Background="Transparent" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Items of the "Move to" / "Assign to" sub-menus. Each item's DataContext is a column / user,
         but the command lives on the card, so reach it through the ContextMenu's PlacementTarget. -->
    <Style x:Key="MoveTargetMenuItemStyle" TargetType="MenuItem">
      <Setter Property="Header" Value="{Binding Title}" />
      <Setter Property="Command"
              Value="{Binding PlacementTarget.DataContext.MoveToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
      <Setter Property="CommandParameter" Value="{Binding Status}" />
    </Style>

    <Style x:Key="AssignTargetMenuItemStyle" TargetType="MenuItem">
      <Setter Property="Header" Value="{Binding FullName}" />
      <Setter Property="Command"
              Value="{Binding PlacementTarget.DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
      <Setter Property="CommandParameter" Value="{Binding}" />
    </Style>

    <!-- A column's list: transparent (but hit-testable, so empty columns accept drops), no chrome. -->
    <Style x:Key="CardListStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <!-- Drops compute the insertion slot from the item containers, so keep them all realized. -->
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The selection ring around a card. -->
    <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="SelectionRing" CornerRadius="8" BorderThickness="2"
                    BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:CardViewModel}">
      <Border x:Name="CardRoot" CornerRadius="6" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>

        <Border.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
        </Border.InputBindings>

        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Edit title…" Command="{Binding EditCommand}" />
            <MenuItem Header="Move to" ItemsSource="{Binding MoveTargets}"
                      ItemContainerStyle="{StaticResource MoveTargetMenuItemStyle}" />
            <MenuItem Header="Assign to" ItemsSource="{Binding AssignTargets}"
                      ItemContainerStyle="{StaticResource AssignTargetMenuItemStyle}" />
            <MenuItem Header="Unassign" Command="{Binding UnassignCommand}" />
            <Separator />
            <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" />
          </ContextMenu>
        </Border.ContextMenu>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Accent edge, colored by the card's status -->
          <Border Width="4" CornerRadius="5,0,0,5"
                  Background="{Binding Item.Status, Converter={StaticResource StatusBrush}}" />

          <Grid Grid.Column="1" Margin="10,8,6,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="{Binding Item.Id, StringFormat='#{0}'}" FontWeight="SemiBold" Margin="0,3,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Item.Title}" TextWrapping="Wrap" Margin="8,3,8,0" />
              <Button Grid.Column="2" Content="&#xE712;" Style="{StaticResource CardMenuButtonStyle}"
                      Tag="{Binding ElementName=CardRoot}" Click="CardMenuButton_Click"
                      ToolTip="Actions" AutomationProperties.Name="Card actions" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
              <Border Width="24" Height="24" CornerRadius="12"
                      Background="{Binding Item.Assignee, Converter={StaticResource UserColor}}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Item.Assignee}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Item.Assignee.Initials}" Foreground="White" FontSize="10.5"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding AssigneeName}" VerticalAlignment="Center" Margin="8,0,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ColumnTemplate" DataType="{x:Type vm:ColumnViewModel}">
      <Border Margin="6,0" Padding="10,12,10,10" CornerRadius="10"
              Background="{DynamicResource ColumnBackgroundBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                    Background="{DynamicResource BadgeBackgroundBrush}">
              <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Items}"
                   ItemTemplate="{StaticResource CardTemplate}"
                   ItemContainerStyle="{StaticResource CardContainerStyle}"
                   Style="{StaticResource CardListStyle}"
                   AutomationProperties.Name="{Binding Title}"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="CardList_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="CardList_PreviewMouseMove"
                   DragOver="CardList_DragOver"
                   DragLeave="CardList_DragLeave"
                   Drop="CardList_Drop" />

          <!-- Empty-column hint; not hit-testable so drops still reach the list underneath. -->
          <TextBlock Grid.Row="1" Text="Drop cards here" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,24,0,0" IsHitTestVisible="False"
                     Foreground="{DynamicResource SecondaryTextBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <Grid Margin="16,16,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Add a work item: type a title and press Enter (or click Add). -->
    <Grid Margin="6,0,6,14" Width="480" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid>
        <TextBox x:Name="NewItemBox" Padding="10,6" FontSize="14" MaxLength="200"
                 Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="New work item title">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="Add a work item…" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource SecondaryTextBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=NewItemBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <Button Grid.Column="1" Content="Add" Margin="8,0,0,0" Padding="18,6"
              Command="{Binding AddItemCommand}" />
    </Grid>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource ColumnTemplate}"
                  Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </Grid>

</Window>
