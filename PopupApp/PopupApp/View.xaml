<Window x:Class="PopupApp.View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PopupApp"
        Title="Popup"
        SizeToContent="WidthAndHeight"
        MinWidth="440"
        Icon="PopupApp.ico">
    <Window.DataContext>
        <local:ViewModel />
    </Window.DataContext>

    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Auto + SharedSizeGroup: both columns size to their content, then take the wider of the two. -->
            <ColumnDefinition Width="Auto" SharedSizeGroup="Columns" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Columns" />
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="AliceBlue" Offset="0.0" />
                <GradientStop Color="SlateBlue" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ===== Column 0: popup whose content is declared inline ===== -->
        <ToggleButton x:Name="gridToggle" Style="{StaticResource DropDownToggleStyle}"
                      Content="{Binding SelectionSummary}" />

        <Popup IsOpen="{Binding IsChecked, ElementName=gridToggle, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=gridToggle}" Placement="Bottom"
               PopupAnimation="Slide">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    MinWidth="{Binding ActualWidth, ElementName=gridToggle}">
                <Grid Background="{StaticResource PanelBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Data}" Style="{StaticResource SelectionGridStyle}" Margin="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- A plain CheckBox toggles with one click; DataGridCheckBoxColumn needs two. -->
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="1" Height="100" Margin="2" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </Popup>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Data}" Style="{StaticResource SelectionGridStyle}"
                  IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=OneWay}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBox Grid.Row="2" Margin="10" VerticalAlignment="Top"
                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- ===== Column 1: popup whose content is a reusable UserControl ===== -->
        <!-- The Popup is a sibling of the button, not a child. A Popup nested inside a ToggleButton routes
             clicks from its own content up to the button, which would toggle it unexpectedly. -->
        <ToggleButton x:Name="controlToggle" Grid.Column="1" Style="{StaticResource DropDownToggleStyle}"
                      IsChecked="{Binding IsItemsControlOpen, Mode=TwoWay}"
                      Content="{Binding SelectionSummary}" />

        <Popup Grid.Column="1" IsOpen="{Binding IsItemsControlOpen, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=controlToggle}" Placement="Bottom"
               PopupAnimation="Slide">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <local:MyUserControl />
            </Border>
        </Popup>

        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Data}" Margin="10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"
                              IsThreeState="False" Margin="2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox Grid.Row="2" Grid.Column="1" Margin="10" VerticalAlignment="Top"
                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Foreground="{Binding SelectedBrush.Brush}" />
    </Grid>
</Window>
