<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>kanban.ico</ApplicationIcon>

    <!-- Application.ThemeMode (the built-in Fluent theme) is still marked [Experimental("WPF0001")] in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="kanban.ico" />
    <Resource Include="kanban.ico" />
  </ItemGroup>

</Project>
