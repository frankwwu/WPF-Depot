<UserControl x:Class="PopupApp.MyUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{StaticResource PanelBrush}" MinWidth="260">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" ItemsSource="{Binding Data}" Background="White" Padding="4" Margin="4,4,4,2">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"
                              IsThreeState="False" Margin="2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,2">
            <Button Content="Select all" Command="{Binding SelectAllCommand}" Padding="8,2" Margin="0,0,4,0" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Padding="8,2" />
        </StackPanel>

        <TextBox Grid.Row="2" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Foreground="{Binding SelectedBrush.Brush}"
                 Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="4,2" />

        <ListBox Grid.Row="3" ItemsSource="{Binding BrushList}" SelectedItem="{Binding SelectedBrush, Mode=TwoWay}"
                 MaxHeight="120" Margin="4,2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Rectangle Fill="{Binding Brush}" Stroke="Gray" StrokeThickness="0.5"
                               Width="14" Height="14" Margin="1" ToolTip="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="12" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button Grid.Row="4" Content="Close" Command="{Binding CloseCommand}"
                Width="80" HorizontalAlignment="Right" Margin="4,4,4,6" />
    </Grid>
</UserControl>
